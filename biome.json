{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["@hugomrdias/configs/biome"],
  "vcs": {
    "defaultBranch": "master"
  },
  "files": {
    "includes": [
      "!!**/src/inline",
      "!!**/pkg-bundler",
      "!!rs/commp/target",
      "!!compare/.build",
      "!!compare/results"
    ]
  },
  "overrides": [
    {
      "includes": ["**/scripts/**", "**/bench.js", "compare/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ]
}
