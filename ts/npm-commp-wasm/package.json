{
  "name": "@commp/wasm",
  "version": "0.1.0",
  "description": "Fast CommP (Filecoin Piece Commitment) WASM implementation",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "pkg"
  ],
  "scripts": {
    "build:wasm": "cd ../../rs/commp && wasm-pack build --target web --out-dir ../../ts/npm-commp-wasm/pkg",
    "build:ts": "tsc",
    "build": "pnpm build:wasm && pnpm build:ts",
    "clean": "rm -rf dist pkg"
  },
  "keywords": [
    "filecoin",
    "commp",
    "piece-commitment",
    "wasm",
    "merkle-tree",
    "fr32"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.3.0"
  }
}

