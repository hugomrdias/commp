{
  "name": "commp-repo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "build:wasm": "pnpm --filter @hugomrdias/commp-wasm build:wasm",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "lint:root": "biome check package.json biome.json pnpm-workspace.yaml tsconfig.base.json turbo.json .github compare",
    "bench": "pnpm --filter bench bench",
    "bench:browser": "pnpm --filter bench bench:browser",
    "compare": "node compare/run.js",
    "check": "turbo run test lint && pnpm lint:root",
    "check:fix": "biome check --fix ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@hugomrdias/configs": "1.1.3",
    "turbo": "2.10.13"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  }
}
