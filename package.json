{
  "name": "commp",
  "version": "1.0.0",
  "type": "module",
  "description": "Fast CommP (Filecoin Piece Commitment) implementation in Rust/WASM",
  "main": "index.js",
  "scripts": {
    "build": "pnpm -r build",
    "test": "mocha 'ts/tests/*.test.js' 'ts/*/tests/*.test.js'",
    "bench": "node bench.js",
    "bench:browser": "playwright-test bench.js --runner none",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@12.8.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@web3-storage/data-segment": "^5.3.0",
    "@webbuf/sha256": "^4.0.1",
    "tinybench": "^6.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "mocha": "^12.0.2",
    "playwright-test": "^15.0.1"
  }
}
